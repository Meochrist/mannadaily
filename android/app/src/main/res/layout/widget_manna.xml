<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#4F46E5"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- En-tête : streak + mascotte Manny -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/widgetStreak"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔥 0 jours"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widgetMannyIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/mascotte_neutral"
            android:contentDescription="MannaDaily mascot"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Message de la mascotte -->
    <TextView
        android:id="@+id/widgetMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ouvre l'app pour synchroniser."
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <!-- Verset du jour -->
    <TextView
        android:id="@+id/widgetVerse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#E0E7FF"
        android:textSize="12sp"
        android:maxLines="3"
        android:ellipsize="end"
        android:paddingBottom="12dp" />

    <!-- Bouton Méditer -->
    <TextView
        android:id="@+id/widgetMeditateButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:text="Méditer →"
        android:textColor="#4F46E5"
        android:textAlignment="center"
        android:textStyle="bold"
        android:textSize="14sp"
        android:padding="12dp"
        android:layout_marginTop="4dp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
