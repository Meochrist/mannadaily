<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetSmallContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="6dp"
    android:background="@drawable/widget_small_background"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- Mascotte Manny compacte (16dp) -->
    <ImageView
        android:id="@+id/widgetMannyIcon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/manny_neutral"
        android:contentDescription="MannaDaily mascot"
        android:layout_marginEnd="6dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true" />

    <!-- Streak + Message -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widgetSmallStreak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 0"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widgetSmallMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bonjour ! Prêt ?"
            android:textColor="#E0E7FF"
            android:textSize="9sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingExtra="-2dp" />
    </LinearLayout>

</LinearLayout>
